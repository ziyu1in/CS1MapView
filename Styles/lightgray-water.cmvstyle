<?xml version="1.0" encoding="utf-8"?>
<MapStyle xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" contentVersion="4.1" fileVersion="4.1">
  <BuildingBorder>
    <Size fixed="0.2" scaled="0.1" />
  </BuildingBorder>
  <StationBorder>
    <Size fixed="0.5" scaled="0.2" />
  </StationBorder>
  <GridLine>
    <Size fixed="1.5" scaled="0" />
    <DashStyle>
      <Dashes>
        <Dash>2</Dash>
        <Dash>2</Dash>
        <Dash>0</Dash>
        <Dash>2</Dash>
      </Dashes>
      <Offset>0</Offset>
    </DashStyle>
  </GridLine>
  <MapSymbolSize fixed="2" scaled="5" />
  <ContourWide>
    <Size fixed="0.5" scaled="0" />
  </ContourWide>
  <ContourMiddle>
    <Size fixed="0.2" scaled="0" />
  </ContourMiddle>
  <ContourNarrow>
    <Size fixed="0.1" scaled="0" />
    <DashStyle>
      <Dashes>
        <Dash>30</Dash>
        <Dash>10</Dash>
      </Dashes>
      <Offset>0</Offset>
    </DashStyle>
  </ContourNarrow>
  <CoastLine>
    <Size fixed="0.5" scaled="0" />
  </CoastLine>
  <Colors>
    <LandColors>
      <Color a="255" r="255" g="255" b="255" threshold="-3.40282347E+38" />
    </LandColors>
    <WaterColors>
      <Color a="255" r="170" g="190" b="210" threshold="-3.40282347E+38" />
    </WaterColors>
    <RouteMapColors>
      <Color a="255" r="255" g="0" b="0" />
      <Color a="255" r="0" g="130" b="0" />
      <Color a="255" r="0" g="0" b="255" />
      <Color a="255" r="0" g="170" b="255" />
      <Color a="255" r="230" g="80" b="0" />
      <Color a="255" r="100" g="0" b="190" />
      <Color a="255" r="160" g="0" b="100" />
    </RouteMapColors>
    <GridLine a="120" r="150" g="150" b="150" />
    <BuildingBorder a="255" r="200" g="200" b="200" />
    <ResidentialBuilding a="255" r="255" g="255" b="255" />
    <CommercialBuilding a="255" r="255" g="255" b="255" />
    <IndustrialBuilding a="255" r="255" g="255" b="255" />
    <OfficeBuilding a="255" r="255" g="255" b="255" />
    <PublicTransportBuilding a="255" r="255" g="255" b="255" />
    <PublicBuilding a="255" r="255" g="255" b="255" />
    <BeautificationBuilding a="255" r="255" g="255" b="255" />
    <Railway a="255" r="180" g="180" b="180" />
    <RailwayDash a="255" r="255" g="255" b="255" />
    <RailwayTunnel a="255" r="180" g="180" b="180" />
    <Metroway a="180" r="180" g="180" b="180" />
    <MetrowayDash a="180" r="255" g="255" b="255" />
    <Tramway a="255" r="180" g="180" b="180" />
    <TramwayDash a="255" r="255" g="255" b="255" />
    <Road a="255" r="220" g="220" b="220" />
    <RoadBorder a="0" r="220" g="220" b="220" />
    <RoadTunnel a="255" r="220" g="220" b="220" />
    <RoadTunnelBorder a="0" r="220" g="220" b="220" />
    <RoadEleavted a="255" r="220" g="220" b="220" />
    <RoadElevatedBorder a="255" r="255" g="255" b="255" />
    <Highway a="255" r="160" g="160" b="160" />
    <HighwayBorder a="0" r="160" g="160" b="160" />
    <HighwayTunnel a="255" r="160" g="160" b="160" />
    <HighwayTunnelBorder a="0" r="160" g="160" b="160" />
    <HighwayEleavted a="255" r="160" g="160" b="160" />
    <HighwayElevatedBorder a="255" r="255" g="255" b="255" />
    <Beautification a="255" r="240" g="240" b="240" />
    <BeautificationBorder a="0" r="240" g="240" b="240" />
    <BeautificationTunnel a="255" r="240" g="240" b="240" />
    <BeautificationTunnelBorder a="0" r="240" g="240" b="240" />
    <BeautificationElevated a="255" r="240" g="240" b="240" />
    <BeautificationElevatedBorder a="255" r="255" g="255" b="255" />
    <ForestBase a="255" r="160" g="160" b="160" />
    <CableCarWay a="255" r="180" g="180" b="180" />
    <MonorailWay a="255" r="180" g="180" b="180" />
    <ContourLine a="200" r="100" g="100" b="100" />
    <Coastline a="255" r="155" g="175" b="180" />
  </Colors>
  <TextColors>
    <DistrictName a="255" r="50" g="50" b="50" />
    <DistrictNameBorder a="180" r="255" g="255" b="255" />
    <BuildingName a="255" r="60" g="60" b="60" />
    <BuildingNameBorder a="220" r="255" g="255" b="255" />
    <DistrictParkName a="255" r="50" g="50" b="50" />
    <DistrictParkNameBorder a="180" r="255" g="255" b="255" />
    <StopNameBorder a="200" r="255" g="255" b="255" />
    <StopNameBorderBlack a="200" r="0" g="0" b="0" />
    <BusStop a="255" r="0" g="0" b="200" />
    <TramStop a="255" r="0" g="180" b="140" />
    <MetroStop a="255" r="0" g="140" b="180" />
    <TrainStop a="255" r="180" g="0" b="0" />
    <RoadName a="180" r="60" g="60" b="60" />
    <RoadNameBorder a="180" r="255" g="255" b="255" />
  </TextColors>
  <WayWidth>
    <TrainRail fixed="3" scaled="1.8" />
    <TrainRailDash fixed="1" scaled="1.8" />
    <TrainRailTunnel fixed="1" scaled="1.5" />
    <TramRail fixed="2.5" scaled="1.3" />
    <TramRailDash fixed="1" scaled="1.3" />
    <MetroRail fixed="3" scaled="1.5" />
    <MetroRailDash fixed="1" scaled="1.5" />
    <Beautification fixed="1" scaled="0.6" />
    <CableCarRail fixed="0.6" scaled="0.3" />
    <CableCarDecorationSpan fixed="1" scaled="15" />
    <CableCarDecorationLength fixed="0.6" scaled="0.3" />
    <CableCarDecorationWidth fixed="0.3" scaled="0.2" />
    <CableCarStationWidth fixed="1.4" scaled="0.3" />
    <MonorailRail fixed="1" scaled="1" />
    <MonorailDecorationSpan fixed="2" scaled="25" />
    <MonorailDecorationLength fixed="1" scaled="1" />
    <MonorailDecorationWidth fixed="0.6" scaled="0.6" />
    <MonorailStationWidth fixed="3" scaled="1.8" />
    <RoadNarrow fixed="1" scaled="0.7" />
    <Road fixed="1" scaled="1.9" />
    <RoadWide fixed="1" scaled="4.3" />
    <RoadVeryWide fixed="1" scaled="6" />
    <HighwayRamp fixed="1" scaled="1.5" />
    <Highway fixed="1" scaled="1.9" />
    <HighwayWide fixed="1" scaled="4" />
  </WayWidth>
  <WayBorder>
    <BeautificationBorder>
      <Size fixed="1" scaled="0" />
    </BeautificationBorder>
    <BeautificationTunnelBorder>
      <Size fixed="1" scaled="0" />
      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </BeautificationTunnelBorder>
    <BeautificationElevatedBorder>
      <Size fixed="1" scaled="0" />
    </BeautificationElevatedBorder>
    <RoadBorder>
      <Size fixed="1" scaled="0" />
    </RoadBorder>
    <RoadTunnelBorder>
      <Size fixed="1" scaled="0" />
      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </RoadTunnelBorder>
    <RoadElevatedBorder>
      <Size fixed="2" scaled="0" />
    </RoadElevatedBorder>
    <HighwayBorder>
      <Size fixed="1.7" scaled="0" />
    </HighwayBorder>
    <HighwayTunnelBorder>
      <Size fixed="2" scaled="0" />
      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </HighwayTunnelBorder>
    <HighwayElevatedBorder>
      <Size fixed="2" scaled="0" />
    </HighwayElevatedBorder>
  </WayBorder>
  <FontSize>
    <TransportStopFontSize fixed="4" scaled="6" />
    <TransportStopFontBorderSize fixed="1" scaled="0.2" />
    <DistrictFontSize fixed="4" scaled="7" />
    <DistrictFontBorderSize fixed="1" scaled="1" />
    <DistrictParkFontSize fixed="2.8" scaled="3" />
    <DistrictParkFontBorderSize fixed="1" scaled="0.3" />
    <BuildingFontSize fixed="3" scaled="3" />
    <BuildingFontBorderSize fixed="1" scaled="0" />
    <RoadNameFontSize fixed="2.6" scaled="2.8" />
    <RoadNameFontBorderSize fixed="0.8" scaled="0" />
  </FontSize>
</MapStyle>