<?xml version="1.0" encoding="utf-8"?>
<MapStyle xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" contentVersion="4.1" fileVersion="4.1">
  <BuildingBorder>
    <Size fixed="0.3" scaled="0.1" />
  </BuildingBorder>
  <StationBorder>
    <Size fixed="0.5" scaled="0.2" />
  </StationBorder>
  <GridLine>
    <Size fixed="2" scaled="0" />
    <DashStyle>
      <Dashes>
        <Dash>2</Dash>
        <Dash>2</Dash>
        <Dash>0</Dash>
        <Dash>2</Dash>
      </Dashes>
      <Offset>0</Offset>
    </DashStyle>
  </GridLine>
  <MapSymbolSize fixed="2" scaled="5" />
  <ContourWide>
    <Size fixed="0.5" scaled="0" />
  </ContourWide>
  <ContourMiddle>
    <Size fixed="0.2" scaled="0" />
  </ContourMiddle>
  <ContourNarrow>
    <Size fixed="0.1" scaled="0" />
    <DashStyle>
      <Dashes>
        <Dash>30</Dash>
        <Dash>10</Dash>
      </Dashes>
      <Offset>0</Offset>
    </DashStyle>
  </ContourNarrow>
  <CoastLine>
    <Size fixed="0.5" scaled="0" />
  </CoastLine>
  <Colors>
    <LandColors>
      <Color a="255" r="181" g="131" b="67" threshold="850" />
      <Color a="255" r="187" g="141" b="77" threshold="700" />
