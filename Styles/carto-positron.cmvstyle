  <FontSize>
    <TransportStopFontSize fixed="4" scaled="4" />
    <TransportStopFontBorderSize fixed="0.7" scaled="0.12" />
    <DistrictFontSize fixed="6" scaled="8" />
    <DistrictFontBorderSize fixed="0.8" scaled="0.2" />
    <DistrictParkFontSize fixed="4" scaled="5" />
    <DistrictParkFontBorderSize fixed="0.7" scaled="0.12" />
    <BuildingFontSize fixed="3" scaled="3.5" />
    <BuildingFontBorderSize fixed="0.6" scaled="0.10" />
    <RoadNameFontSize fixed="3" scaled="3.2" />
    <RoadNameFontBorderSize fixed="0.65" scaled="0.10" />
  </FontSize>
  <RoadHierarchy>
    <Enabled>true</Enabled>
    <NarrowRoadMaxWidth>12</NarrowRoadMaxWidth>
    <Narrow>
      <Fill a="255" r="212" g="218" b="221" />
      <Border a="255" r="212" g="218" b="221" />
      <TunnelFill a="255" r="224" g="228" b="231" />
      <TunnelBorder a="255" r="203" g="210" b="215" />
      <ElevatedFill a="255" r="212" g="218" b="221" />
      <ElevatedBorder a="255" r="190" g="200" b="206" />
    </Narrow>
    <Intermediate>
      <ElevatedFill a="255" r="255" g="255" b="255" />
      <TunnelFill a="255" r="250" g="251" b="251" />
      <Border a="255" r="189" g="195" b="199" />
      <TunnelBorder a="255" r="210" g="215" b="218" />
      <Fill a="255" r="255" g="255" b="255" />
      <ElevatedBorder a="255" r="172" g="181" b="188" />
    </Intermediate>
    <Major>
      <ElevatedFill a="255" r="255" g="255" b="255" />
      <TunnelFill a="255" r="250" g="251" b="251" />
      <Border a="255" r="170" g="176" b="180" />
      <TunnelBorder a="255" r="195" g="201" b="205" />
      <Fill a="255" r="255" g="255" b="255" />
      <ElevatedBorder a="255" r="152" g="163" b="171" />
    </Major>
  </RoadHierarchy>
</MapStyle>
