      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </BeautificationTunnelBorder>
    <BeautificationElevatedBorder>
      <Size fixed="0.6" scaled="0.05" />
    </BeautificationElevatedBorder>
    <RoadBorder>
      <Size fixed="0.65" scaled="0.10" />
    </RoadBorder>
    <RoadTunnelBorder>
