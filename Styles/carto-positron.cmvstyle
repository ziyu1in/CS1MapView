      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </RoadTunnelBorder>
    <RoadElevatedBorder>
      <Size fixed="1.0" scaled="0.15" />
    </RoadElevatedBorder>
    <HighwayBorder>
      <Size fixed="0.8" scaled="0.15" />
    </HighwayBorder>
    <HighwayTunnelBorder>
      <Size fixed="0.65" scaled="0.10" />
      <DashStyle>
        <Dashes>
          <Dash>1.5</Dash>
          <Dash>2</Dash>
        </Dashes>
        <Offset>0</Offset>
      </DashStyle>
    </HighwayTunnelBorder>
    <HighwayElevatedBorder>
